# Public configuration. Do not mark these values as secrets in your hosting provider.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<copy-from-supabase-dashboard>"
APP_ORIGIN="https://vodinhquan.dev"
SITE_OWNER_GITHUB_USERNAME="your-github-username"

# Server-only Cloudinary values. Prefer CLOUDINARY_URL locally and set
# individual values in hosting if that is easier for secret management.
CLOUDINARY_URL="cloudinary://<api-key>:<api-secret>@<cloud-name>"
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
CLOUDINARY_MOMENTS_FOLDER="moments"

# Server-only cleanup worker credentials. The scheduled GitHub Actions workflow
# sends MEDIA_CLEANUP_SECRET to the route; the route uses the service role only
# to claim and update outbox jobs.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
MEDIA_CLEANUP_SECRET="<at-least-32-random-characters>"
